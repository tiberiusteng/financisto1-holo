<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_nl_dialog_subtitle"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/et_nl_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top|start"
        android:hint="@string/ai_nl_input_hint"
        android:padding="10dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="15sp" />

    <!-- Sample Chips Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sample_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_nl_sample_1"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/btn_sample_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ai_nl_sample_2"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/btn_sample_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ai_nl_sample_3"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/btn_sample_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ai_nl_sample_4"
                style="?android:attr/buttonStyleSmall" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        style="@style/EditDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp" />

    <!-- Real-time Preview Section -->
    <TextView
        style="@style/ContactListSeparatorTextViewStyle"
        android:text="@string/ai_nl_preview_title"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_preview_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/ai_nl_preview_waiting"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorPrimary" />

</LinearLayout>

